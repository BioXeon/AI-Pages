    function createTermItem(termObj) {
      const item = document.createElement("div");
      item.className = "term-item";

      const left = document.createElement("div");
      const right = document.createElement("div");
      right.className = "term-right";

      const header = document.createElement("div");
      header.className = "term-header";

      const name = document.createElement("div");
      name.className = "term-name";
      name.textContent = termObj.term;
      name.title = "Click to copy term";
      name.style.cursor = "pointer";
      name.addEventListener("click", () => {
        navigator.clipboard.writeText(termObj.term).catch(() => {});
      });

      const tag = document.createElement("div");
      tag.className = "term-tag";
      tag.textContent = termObj.category;

      header.appendChild(name);
      header.appendChild(tag);

      const meta = document.createElement("div");
      meta.className = "term-meta";
      meta.textContent = `Tags: ${termObj.tags.join(", ")} · Level: ${termObj.level}`;

      const desc = document.createElement("div");
      desc.className = "term-desc";
      desc.textContent = termObj.description;

      left.appendChild(header);
      left.appendChild(meta);
      left.appendChild(desc);

      const label = document.createElement("div");
      label.className = "term-label";
      label.textContent = termObj.tagline;
      right.appendChild(label);

      if (termObj.tagline) {
        const tagline = document.createElement("div");
        tagline.className = "term-tagline";
        tagline.textContent = termObj.tagline;
        right.appendChild(tagline);
      }

      if (termObj.links && termObj.links.length) {
        const links = document.createElement("div");
        links.className = "term-links";
        termObj.links.forEach((l) => {
          const pill = document.createElement("div");
          pill.className = "term-link-pill";
          pill.textContent = l;
          links.appendChild(pill);
        });
        right.appendChild(links);
      }

      item.appendChild(left);
      item.appendChild(right);

      return item;
    }

    const termListEl = document.getElementById("termList");
    const searchInputEl = document.getElementById("searchInput");
    const visibleCountEl = document.getElementById("visibleCount");
    const selectedCategoryLabelEl = document.getElementById("selectedCategoryLabel");
    const chipsEl = document.getElementById("categoryChips");

    function renderTerms(filterCategory = "all", search = "") {
      termListEl.innerHTML = "";
      const normalizedSearch = search.trim().toLowerCase();
      let visibleCount = 0;

      TERMS.forEach((t) => {
        const matchesCategory = filterCategory === "all" || t.category === filterCategory;
        const text = `${t.term} ${t.category} ${t.tags.join(" ")} ${t.description} ${t.tagline}`.toLowerCase();
        const matchesSearch = !normalizedSearch || text.includes(normalizedSearch);

        if (matchesCategory && matchesSearch) {
          const item = createTermItem(t);
          if (normalizedSearch && text.includes(normalizedSearch)) {
            item.classList.add("highlighted");
          }
          termListEl.appendChild(item);
          visibleCount += 1;
        }
      });

      visibleCountEl.textContent = visibleCount;
    }

    renderTerms("all", "");

    chipsEl.addEventListener("click", (e) => {
      if (e.target.matches(".chip")) {
        const category = e.target.getAttribute("data-category");
        chipsEl.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
        e.target.classList.add("active");
        selectedCategoryLabelEl.textContent = category;
        renderTerms(category, searchInputEl.value);
      }
    });

    searchInputEl.addEventListener("input", () => {
      const activeChip = chipsEl.querySelector(".chip.active");
      const category = activeChip ? activeChip.getAttribute("data-category") : "all";
      renderTerms(category, searchInputEl.value);
    });

    function scrollToGlossary() {
      const el = document.getElementById("glossary");
      if (el) {
        el.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }
  </script>
